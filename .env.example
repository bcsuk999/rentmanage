NODE_ENV=development
PORT=3000

# Signs API tokens (falls back to SESSION_SECRET when unset).
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed origins for browsers. Mobile apps are unaffected.
CORS_ORIGINS=*

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@rentmanage.tsyu0ap.mongodb.net/rentmanage?appName=rentmanage

# Resolvers used for the Atlas SRV lookup (comma separated)
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Landlord seed (mobile login). Used on server start to create the landlord if
# missing, so a fresh deployment can be logged into without a shell.
LANDLORD_NAME=Landlord
LANDLORD_MOBILE=9876543210
LANDLORD_PASSWORD=Landlord@123

# Legacy seed (username login). Kept so installs created before the
# mobile-login migration can still sign in. New installs should prefer
# LANDLORD_* above.
ADMIN_NAME=Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_CONTACT=admin@example.com

# Self-service sign-up creates read-only accounts. Set to false to disable POST /api/auth/register.
ALLOW_REGISTRATION=true
