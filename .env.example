NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@rentmanage.tsyu0ap.mongodb.net/rentmanage?appName=rentmanage

# Resolvers used for the Atlas SRV lookup (comma separated)
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Seed admin account (used by `npm run seed`)
ADMIN_NAME=Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_CONTACT=admin@example.com
