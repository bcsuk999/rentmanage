<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent drawable used to hide the Android 12+ system splash
     icon, so the launch is a seamless fade into the app's own animated
     splash (no black screen, no duplicate logo). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
