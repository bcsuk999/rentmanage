<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-Mode + Android 12+ override. The "night" qualifier beats the
         "version" qualifier, so this file is required to keep the launch
         window light (never black) even when the OS is in Dark Mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
