{
  "name": "Room Rent Manager",
  "short_name": "Rent Manager",
  "description": "Room-first rent management: rooms, members, rental cycles and payments.",
  "id": "/rooms",
  "start_url": "/rooms",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f4f6fa",
