<%
  const value = (field) => (typeof body !== 'undefined' && body && body[field] !== undefined ? body[field] : '');
  const errorFor = (field) => {
    if (typeof errors === 'undefined' || !errors) return null;
    const hit = errors.find((e) => e.field === field);
    return hit ? hit.message : null;
  };
%>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="toast-wrap toast-inline" role="alert">
    <div class="toast flash flash-error" data-toast>
      <span class="toast-dot" aria-hidden="true"></span>
      <span class="toast-msg"><%= error %></span>
      <button class="toast-close" type="button" data-toast-close aria-label="Dismiss">×</button>
    </div>
  </div>
<% } %>
<% if (typeof errors !== 'undefined' && errors && errors.filter((e) => !e.field).length) { %>
  <div class="toast-wrap toast-inline" role="alert">
    <div class="toast flash flash-error" data-toast>
      <span class="toast-dot" aria-hidden="true"></span>
      <span class="toast-msg"><%= errors.filter((e) => !e.field).map((e) => e.message).join(' ') %></span>
      <button class="toast-close" type="button" data-toast-close aria-label="Dismiss">×</button>
    </div>
  </div>
<% } %>
