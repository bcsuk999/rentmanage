<%
  const value = (field) => (typeof body !== 'undefined' && body && body[field] !== undefined ? body[field] : '');
  const errorFor = (field) => {
    if (typeof errors === 'undefined' || !errors) return null;
    const hit = errors.find((e) => e.field === field);
    return hit ? hit.message : null;
  };
%>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="flash flash-error"><%= error %></div>
<% } %>
<% if (typeof errors !== 'undefined' && errors && errors.filter((e) => !e.field).length) { %>
  <div class="flash flash-error"><%= errors.filter((e) => !e.field).map((e) => e.message).join(' ') %></div>
<% } %>
