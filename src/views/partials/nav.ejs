<header class="topbar">
  <a class="brand" href="/rooms">
    <img class="brand-mark" src="/icons/icon-192.png" alt="" width="28" height="28">
    <span>Rent Manager</span>
  </a>
  <% if (currentUser) { %>
    <button class="nav-toggle" type="button" data-sidebar-open aria-expanded="false" aria-controls="app-sidebar" aria-label="Open navigation menu">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </button>
    <nav class="nav" id="main-nav">
      <a href="/rooms" class="<%= currentPath.startsWith('/rooms') ? 'active' : '' %>">Rooms</a>
      <a href="/members" class="<%= currentPath.startsWith('/members') ? 'active' : '' %>">Members</a>
      <a href="/payments" class="<%= currentPath.startsWith('/payments') ? 'active' : '' %>">Payments</a>
      <a href="/reports" class="<%= currentPath.startsWith('/reports') ? 'active' : '' %>">Reports</a>
      <% if (isAdmin) { %>
        <a href="/settings" class="<%= currentPath.startsWith('/settings') ? 'active' : '' %>">Settings</a>
      <% } %>
    </nav>
    <div class="user">
      <button class="btn btn-ghost install-btn" type="button" data-install hidden>Install app</button>
      <span class="muted user-name"><%= currentUser.name %></span>
      <span class="pill pill-role"><%= isAdmin ? 'Admin' : 'Viewer' %></span>
      <form method="post" action="/logout" class="inline">
        <button class="btn btn-ghost" type="submit">Logout</button>
      </form>
    </div>
  <% } %>
</header>
<% if (currentUser) { %>
  <div class="sidebar-backdrop" data-sidebar-close hidden></div>
  <aside class="sidebar" id="app-sidebar" aria-label="App navigation" aria-hidden="true">
    <div class="sidebar-head">
      <span class="sidebar-brand">
        <img class="brand-mark" src="/icons/icon-192.png" alt="" width="26" height="26">
        <span>Rent Manager</span>
      </span>
      <button class="sidebar-close" type="button" data-sidebar-close aria-label="Close navigation menu">×</button>
    </div>
    <nav class="sidebar-nav">
      <a href="/rooms" class="<%= currentPath.startsWith('/rooms') ? 'active' : '' %>"><span class="ico" aria-hidden="true">⌂</span>Rooms</a>
      <a href="/members" class="<%= currentPath.startsWith('/members') ? 'active' : '' %>"><span class="ico" aria-hidden="true">👥</span>Members</a>
      <a href="/payments" class="<%= currentPath.startsWith('/payments') ? 'active' : '' %>"><span class="ico" aria-hidden="true">₹</span>Payments</a>
      <a href="/reports" class="<%= currentPath.startsWith('/reports') ? 'active' : '' %>"><span class="ico" aria-hidden="true">📊</span>Reports</a>
      <% if (isAdmin) { %>
        <a href="/settings" class="<%= currentPath.startsWith('/settings') ? 'active' : '' %>"><span class="ico" aria-hidden="true">⚙</span>Settings</a>
      <% } %>
    </nav>
    <div class="sidebar-foot">
      <div class="sidebar-user">
        <span class="sidebar-name"><%= currentUser.name %></span>
        <span class="pill pill-role"><%= isAdmin ? 'Admin' : 'Viewer' %></span>
      </div>
      <button class="btn btn-ghost install-btn" type="button" data-install hidden>Install app</button>
      <form method="post" action="/logout">
        <button class="btn btn-ghost btn-block" type="submit">Logout</button>
      </form>
    </div>
  </aside>
<% } %>
