<div class="page-head">
  <div>
    <h1>My account</h1>
    <p class="muted">Only password changes are allowed from here.</p>
  </div>
  <a class="btn btn-ghost" href="/settings">Back</a>
</div>

<section class="card narrow">
  <div class="detail-grid">
    <div><span class="label">Name</span><span class="value"><%= admin.name %></span></div>
    <div><span class="label">Username</span><span class="value"><%= admin.username %></span></div>
    <div><span class="label">Contact</span><span class="value"><%= admin.contact || '-' %></span></div>
    <div><span class="label">Role</span><span class="value"><%= admin.role %></span></div>
    <div><span class="label">Created</span><span class="value"><%= formatDate(admin.createdAt) %></span></div>
    <div><span class="label">Last login</span><span class="value"><%= admin.lastLoginAt ? formatDate(admin.lastLoginAt) : 'This session' %></span></div>
  </div>
  <div class="actions">
    <a class="btn btn-primary" href="/change-password">Change password</a>
  </div>
</section>
