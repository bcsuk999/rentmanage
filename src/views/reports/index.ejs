<div class="page-head">
  <div>
    <h1>Reports</h1>
    <p class="muted">Selected period: <strong><%= rangeLabel %></strong></p>
  </div>
</div>

<form class="filters card" method="get" action="/reports">
  <div class="field">
    <label for="from">From date</label>
    <input id="from" name="from" type="date" value="<%= filters.from %>" required>
  </div>
  <div class="field">
    <label for="to">To date</label>
    <input id="to" name="to" type="date" value="<%= filters.to %>" required>
  </div>
  <div class="field">
    <label for="roomId">Room</label>
    <select id="roomId" name="roomId">
      <option value="">All rooms</option>
      <% rooms.forEach((r) => { %>
        <option value="<%= r._id %>" <%= filters.roomId === r._id.toString() ? 'selected' : '' %>><%= r.roomNumber %></option>
      <% }) %>
    </select>
  </div>
  <div class="field actions">
    <button class="btn btn-primary" type="submit">Run report</button>
  </div>
</form>

<section class="card">
  <h2>Summary</h2>
  <div class="stat-row wrap">
    <div class="stat"><span class="label">Total rooms</span><span class="value"><%= report.totals.totalRooms %></span></div>
    <div class="stat"><span class="label">Active members</span><span class="value"><%= report.totals.totalMembers %></span></div>
    <div class="stat"><span class="label">Rent periods</span><span class="value"><%= report.totals.periodCount %></span></div>
    <div class="stat"><span class="label">Expected rent</span><span class="value"><%= currency(report.totals.totalRent) %></span></div>
    <div class="stat"><span class="label">Paid</span><span class="value paid"><%= currency(report.totals.totalPaid) %></span></div>
    <div class="stat"><span class="label">Pending</span><span class="value pending"><%= currency(report.totals.totalPending) %></span></div>
    <div class="stat"><span class="label">Received in range</span><span class="value"><%= currency(report.totals.receivedInRange) %></span></div>
  </div>
  <div class="stat-row wrap">
    <div class="stat"><span class="label">Fully paid members</span><span class="value paid"><%= report.totals.paidMembers %></span></div>
    <div class="stat"><span class="label">Partial members</span><span class="value"><%= report.totals.partialMembers %></span></div>
    <div class="stat"><span class="label">Pending members</span><span class="value pending"><%= report.totals.pendingMembers %></span></div>
    <div class="stat"><span class="label">Overdue members</span><span class="value overdue"><%= report.totals.overdueMembers %></span></div>
  </div>
  <% const methods = Object.keys(report.totals.methodTotals); %>
  <% if (methods.length) { %>
    <p class="muted small">
      Cash collected in range by method:
      <% methods.forEach((m) => { %><%= m %>: <strong><%= currency(report.totals.methodTotals[m]) %></strong><%= methods.indexOf(m) < methods.length - 1 ? ' · ' : '' %><% }) %>
    </p>
  <% } %>
</section>

<section class="card table-wrap">
  <h2>Room-wise summary</h2>
  <table>
    <thead>
      <tr><th>Room</th><th>Room status</th><th class="num">Periods</th><th class="num">Rent</th><th class="num">Paid</th><th class="num">Pending</th><th>Payment</th></tr>
    </thead>
    <tbody>
      <% if (!report.byRoom.length) { %>
        <tr><td colspan="7" class="empty">No rent periods in this date range.</td></tr>
      <% } %>
      <% report.byRoom.forEach((row) => { %>
        <tr>
          <td><a href="/rooms/<%= row.roomId %>"><strong><%= row.roomNumber %></strong></a></td>
          <td><span class="pill pill-<%= String(row.roomStatus).toLowerCase() %>"><%= row.roomStatus %></span></td>
          <td class="num"><%= row.periods %></td>
          <td class="num"><%= currency(row.totalRent) %></td>
          <td class="num paid"><%= currency(row.totalPaid) %></td>
          <td class="num pending"><%= currency(row.totalPending) %></td>
          <td><span class="pill pill-<%= row.paymentState.toLowerCase().replace(/\s+/g, '-') %>"><%= row.paymentState %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<section class="card table-wrap">
  <h2>Member-wise summary</h2>
  <table>
    <thead>
      <tr><th>Member</th><th>Room</th><th class="num">Periods</th><th class="num">Rent</th><th class="num">Paid</th><th class="num">Pending</th><th>Latest status</th></tr>
    </thead>
    <tbody>
      <% if (!report.byMember.length) { %>
        <tr><td colspan="7" class="empty">No members in this date range.</td></tr>
      <% } %>
      <% report.byMember.forEach((row) => { %>
        <tr>
          <td><a href="/members/<%= row.memberId %>"><strong><%= row.name %></strong></a><div class="muted small"><%= row.mobile %></div></td>
          <td><a href="/rooms/<%= row.roomId %>"><%= row.roomNumber %></a></td>
          <td class="num"><%= row.periods %></td>
          <td class="num"><%= currency(row.totalRent) %></td>
          <td class="num paid"><%= currency(row.totalPaid) %></td>
          <td class="num pending"><%= currency(row.totalPending) %></td>
          <td><span class="pill pill-<%= row.status.toLowerCase() %>"><%= row.status %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
