<div class="page-head">
  <div>
    <h1>Members</h1>
    <p class="muted">Search by name, mobile, Aadhaar number or room.</p>
  </div>
</div>

<form class="filters card" method="get" action="/members">
  <div class="field">
    <label for="search">Search</label>
    <input id="search" name="search" value="<%= filters.search %>" placeholder="Name, mobile or Aadhaar">
  </div>
  <div class="field">
    <label for="roomId">Room</label>
    <select id="roomId" name="roomId">
      <option value="">All rooms</option>
      <% rooms.forEach((r) => { %>
        <option value="<%= r._id %>" <%= filters.roomId === r._id.toString() ? 'selected' : '' %>><%= r.roomNumber %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
      <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Vacated</option>
      <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All</option>
    </select>
  </div>
  <div class="field actions">
    <button class="btn btn-primary" type="submit">Search</button>
    <a class="btn btn-ghost" href="/members">Reset</a>
  </div>
</form>

<section class="card table-wrap">
  <table class="stack">
    <thead>
      <tr>
        <th>Name</th>
        <th>Room</th>
        <th>Mobile</th>
        <th>Aadhaar</th>
        <th class="num">Monthly rent</th>
        <th>Rent cycle starts</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (!members.length) { %>
        <tr><td colspan="8" class="empty" data-label="">No members found.</td></tr>
      <% } %>
      <% members.forEach((m) => { %>
        <tr>
          <td data-label="Name"><a href="/members/<%= m._id %>"><strong><%= m.name %></strong></a></td>
          <td data-label="Room"><a href="/rooms/<%= m.roomId %>"><%= m.roomNumber %></a></td>
          <td data-label="Mobile"><%= m.mobile %></td>
          <td class="muted" data-label="Aadhaar"><%= maskAadhaar(m.aadhaarNumber) || '—' %></td>
          <td class="num" data-label="Monthly rent"><%= currency(m.monthlyRent) %></td>
          <td data-label="Rent cycle starts"><%= formatDate(m.rentStartDate) %></td>
          <td data-label="Status">
            <span class="pill pill-<%= m.status === 'active' ? 'occupied' : 'empty' %>">
              <%= m.status === 'active' ? 'Active' : 'Vacated' %>
            </span>
          </td>
          <td class="row-actions" data-label=""><a class="btn btn-ghost" href="/members/<%= m._id %>">View details</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
