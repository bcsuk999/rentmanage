<div class="page-head">
  <div>
    <h1>Room <%= room.roomNumber %></h1>
    <p class="muted">
      <span class="pill pill-<%= room.status.toLowerCase() %>"><%= room.status %></span>
      · <%= summary.memberCount %> active member<%= summary.memberCount === 1 ? '' : 's' %>
    </p>
  </div>
  <div class="actions">
    <a class="btn btn-primary" href="/rooms/<%= room._id %>/members/new">+ Add member</a>
    <a class="btn btn-ghost" href="/rooms/<%= room._id %>/edit">Edit room</a>
  </div>
</div>

<section class="card">
  <div class="field">
    <label for="period">Rental period (changes every member's rent and payments shown)</label>
    <select id="period" data-range-select>
      <% ranges.forEach((r) => { %>
        <option value="<%= toDateInput(r.start) %>|<%= toDateInput(r.end) %>"
          <%= range && toDateInput(range.start) === toDateInput(r.start) && toDateInput(range.end) === toDateInput(r.end) ? 'selected' : '' %>>
          <%= formatDateRange(r.start, r.end) %>
        </option>
      <% }) %>
    </select>
  </div>
  <div class="stat-row">
    <div class="stat"><span class="label">Selected period</span><span class="value small"><%= rangeLabel %></span></div>
    <div class="stat"><span class="label">Total rent</span><span class="value"><%= currency(summary.totalRent) %></span></div>
    <div class="stat"><span class="label">Paid</span><span class="value paid"><%= currency(summary.totalPaid) %></span></div>
    <div class="stat"><span class="label">Pending</span><span class="value pending"><%= currency(summary.totalPending) %></span></div>
  </div>
</section>

<section class="card table-wrap">
  <h2>Active members</h2>
  <table class="stack">
    <thead>
      <tr>
        <th>Name</th>
        <th>Monthly rent</th>
        <th class="num">Paid</th>
        <th class="num">Pending</th>
        <th>Status</th>
        <th>Member period</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (!members.length) { %>
        <tr><td colspan="7" class="empty" data-label="">No active members in this room.</td></tr>
      <% } %>
      <% members.forEach((row) => { %>
        <tr>
          <td data-label="Name">
            <a href="/members/<%= row.member._id %>"><strong><%= row.member.name %></strong></a>
            <div class="muted small"><%= row.member.mobile %></div>
          </td>
          <td data-label="Monthly rent"><%= currency(row.member.monthlyRent) %></td>
          <td class="num paid" data-label="Paid"><%= row.period ? currency(row.period.paidAmount) : '-' %></td>
          <td class="num pending" data-label="Pending"><%= row.period ? currency(row.period.pendingAmount) : '-' %></td>
          <td data-label="Status">
            <% if (row.period) { %>
              <span class="pill pill-<%= row.period.status.toLowerCase() %>"><%= row.period.status %></span>
            <% } else { %>
              <span class="pill">No period</span>
            <% } %>
          </td>
          <td data-label="Member period"><%= row.period ? formatDateRange(row.period.startDate, row.period.endDate) : '-' %></td>
          <td class="row-actions" data-label=""><a class="btn btn-ghost" href="/members/<%= row.member._id %>">View details</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<% if (room.notes) { %>
  <section class="card">
    <h2>Room notes</h2>
    <p><%= room.notes %></p>
  </section>
<% } %>

<% if (historical.length) { %>
  <section class="card table-wrap">
    <h2>Vacated members (history kept)</h2>
    <table>
      <thead>
        <tr><th>Name</th><th>Mobile</th><th>Joined</th><th>Vacated on</th><th></th></tr>
      </thead>
      <tbody>
        <% historical.forEach((m) => { %>
          <tr>
            <td><a href="/members/<%= m._id %>"><%= m.name %></a></td>
            <td><%= m.mobile %></td>
            <td><%= formatDate(m.joiningDate) %></td>
            <td><%= m.vacatingDate ? formatDate(m.vacatingDate) : '-' %></td>
            <td class="row-actions"><a class="btn btn-ghost" href="/members/<%= m._id %>">View history</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% } %>
