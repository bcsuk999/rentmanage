<div class="page-head">
  <div>
    <h1>Rooms</h1>
    <p class="muted">Current rental period totals for every room.</p>
  </div>
  <a class="btn btn-primary" href="/rooms/new">+ Add room</a>
</div>

<form class="filters card" method="get" action="/rooms">
  <div class="field">
    <label for="search">Search</label>
    <input id="search" name="search" value="<%= filters.search %>" placeholder="Room number, member name, mobile or Aadhaar">
  </div>
  <div class="field">
    <label for="status">Room status</label>
    <select id="status" name="status">
      <% statuses.forEach((s) => { %>
        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="paymentState">Payment</label>
    <select id="paymentState" name="paymentState">
      <% paymentStates.forEach((s) => { %>
        <option value="<%= s %>" <%= filters.paymentState === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>
  <div class="field actions">
    <button class="btn btn-primary" type="submit">Apply</button>
    <a class="btn btn-ghost" href="/rooms">Reset</a>
  </div>
</form>

<section class="card">
  <div class="stat-row">
    <div class="stat"><span class="label">Rooms</span><span class="value"><%= grand.roomCount %></span></div>
    <div class="stat"><span class="label">Active members</span><span class="value"><%= grand.memberCount %></span></div>
    <div class="stat"><span class="label">Total rent</span><span class="value"><%= currency(grand.totalRent) %></span></div>
    <div class="stat"><span class="label">Paid</span><span class="value paid"><%= currency(grand.totalPaid) %></span></div>
    <div class="stat"><span class="label">Pending</span><span class="value pending"><%= currency(grand.totalPending) %></span></div>
  </div>
</section>

<section class="card table-wrap">
  <table class="stack">
    <thead>
      <tr>
        <th>Room</th>
        <th>Members</th>
        <th>Current rent period</th>
        <th class="num">Total rent</th>
        <th class="num">Paid</th>
        <th class="num">Pending</th>
        <th>Room status</th>
        <th>Payment</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (!rooms.length) { %>
        <tr><td colspan="9" class="empty" data-label="">No rooms match this view. <a href="/rooms/new">Add the first room</a>.</td></tr>
      <% } %>
      <% rooms.forEach((room) => { %>
        <tr>
          <td data-label="Room"><a href="/rooms/<%= room._id %>"><strong><%= room.roomNumber %></strong></a></td>
          <td data-label="Members"><%= room.memberCount %></td>
          <td data-label="Current period">
            <% if (room.periodStart) { %>
              <%= formatDateRange(room.periodStart, room.periodEnd) %>
            <% } else { %>
              <span class="muted">No active cycle</span>
            <% } %>
          </td>
          <td class="num" data-label="Total rent"><%= currency(room.totalRent) %></td>
          <td class="num paid" data-label="Paid"><%= currency(room.totalPaid) %></td>
          <td class="num pending" data-label="Pending"><%= currency(room.totalPending) %></td>
          <td data-label="Room status"><span class="pill pill-<%= room.status.toLowerCase() %>"><%= room.status %></span></td>
          <td data-label="Payment"><span class="pill pill-<%= room.paymentState.toLowerCase().replace(/\s+/g, '-') %>"><%= room.paymentState %></span></td>
          <td class="row-actions" data-label=""><a class="btn btn-ghost" href="/rooms/<%= room._id %>">Open</a> <a class="btn btn-ghost" href="/rooms/<%= room._id %>/edit">Edit</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
