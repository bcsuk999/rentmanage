<div class="page-head">
  <div>
    <h1>Rooms</h1>
    <p class="muted">Current rental period totals for every room.</p>
  </div>
  <% if (isAdmin) { %>
    <a class="btn btn-primary" href="/rooms/new">+ Add room</a>
  <% } %>
</div>

<form class="filters card" method="get" action="/rooms">
  <div class="field">
    <label for="search">Search</label>
    <input id="search" name="search" value="<%= filters.search %>" placeholder="Room number, member name, mobile or Aadhaar">
  </div>
  <div class="field">
    <label for="status">Room status</label>
    <select id="status" name="status">
      <% statuses.forEach((s) => { %>
        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="paymentState">Payment</label>
    <select id="paymentState" name="paymentState">
      <% paymentStates.forEach((s) => { %>
        <option value="<%= s %>" <%= filters.paymentState === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>
  <div class="field actions">
    <button class="btn btn-primary" type="submit">Apply</button>
    <a class="btn btn-ghost" href="/rooms">Reset</a>
  </div>
</form>

<section class="room-grid">
  <% if (!rooms.length) { %>
    <div class="card empty-state">
      <h3>No rooms found</h3>
      <% if (isAdmin) { %>
        <p class="muted">Add your first room <a href="/rooms/new">here</a>.</p>
      <% } %>
    </div>
  <% } %>
  <% rooms.forEach((room) => { %>
    <article class="card room-card">
      <div class="room-card-top">
        <div>
          <p class="muted small room-label">Room</p>
          <h2 class="room-number"><%= room.roomNumber %></h2>
        </div>
        <span class="pill pill-<%= room.status.toLowerCase() %>"><%= room.status %></span>
      </div>
      <p class="occupancy"><strong><%= room.memberCount %>/<%= room.capacity %></strong> <span class="muted">occupied</span>
        <% if (room.isFull) { %><span class="pill pill-full">Full</span><% } %>
      </p>
      <p class="muted small">
        <% if (room.periodStart) { %>
          <%= formatDateRange(room.periodStart, room.periodEnd) %>
        <% } else { %>
          No active cycle
        <% } %>
        · <span class="pill pill-<%= room.paymentState.toLowerCase().replace(/\s+/g, '-') %>"><%= room.paymentState %></span>
      </p>
      <div class="room-card-foot">
        <span class="muted small"><%= currency(room.totalPending) %> pending</span>
        <a class="btn btn-primary" href="/rooms/<%= room._id %>">Details</a>
      </div>
    </article>
  <% }) %>
</section>

<section class="card">
  <div class="stat-row">
    <div class="stat"><span class="label">Rooms</span><span class="value"><%= grand.roomCount %></span></div>
    <div class="stat"><span class="label">Active members</span><span class="value"><%= grand.memberCount %></span></div>
    <div class="stat"><span class="label">Total rent</span><span class="value"><%= currency(grand.totalRent) %></span></div>
    <div class="stat"><span class="label">Paid</span><span class="value paid"><%= currency(grand.totalPaid) %></span></div>
    <div class="stat"><span class="label">Pending</span><span class="value pending"><%= currency(grand.totalPending) %></span></div>
  </div>
</section>