<div class="page-head">
  <div>
    <h1>Payments</h1>
    <p class="muted">Every payment stays as an individual transaction.</p>
  </div>
  <p class="muted"><%= total %> transaction<%= total === 1 ? '' : 's' %> · <strong><%= currency(totalAmount) %></strong></p>
</div>

<form class="filters card" method="get" action="/payments">
  <div class="field">
    <label for="roomId">Room</label>
    <select id="roomId" name="roomId">
      <option value="">All rooms</option>
      <% rooms.forEach((r) => { %>
        <option value="<%= r._id %>" <%= filters.roomId === r._id.toString() ? 'selected' : '' %>><%= r.roomNumber %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="memberId">Member</label>
    <select id="memberId" name="memberId">
      <option value="">All members</option>
      <% members.forEach((m) => { %>
        <option value="<%= m._id %>" <%= filters.memberId === m._id.toString() ? 'selected' : '' %>><%= m.name %> (<%= m.mobile %>)</option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="paymentMethod">Method</label>
    <select id="paymentMethod" name="paymentMethod">
      <option value="">All methods</option>
      <% methods.forEach((m) => { %>
        <option value="<%= m %>" <%= filters.paymentMethod === m ? 'selected' : '' %>><%= m %></option>
      <% }) %>
    </select>
  </div>
  <div class="field">
    <label for="from">Payment date from</label>
    <input id="from" name="from" type="date" value="<%= filters.from %>">
  </div>
  <div class="field">
    <label for="to">Payment date to</label>
    <input id="to" name="to" type="date" value="<%= filters.to %>">
  </div>
  <div class="field actions">
    <button class="btn btn-primary" type="submit">Filter</button>
    <a class="btn btn-ghost" href="/payments">Reset</a>
  </div>
</form>

<section class="card table-wrap">
  <table class="stack">
    <thead>
      <tr>
        <th>Date</th>
        <th>Room</th>
        <th>Member</th>
        <th>Rent period</th>
        <th class="num">Amount</th>
        <th>Method</th>
        <th>Reference</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% if (!rows.length) { %>
        <tr><td colspan="8" class="empty" data-label="">No payments match these filters.</td></tr>
      <% } %>
      <% rows.forEach((p) => { %>
        <tr>
          <td data-label="Date"><%= formatDate(p.paymentDate) %></td>
          <td data-label="Room"><a href="/rooms/<%= p.roomId ? p.roomId._id : '' %>"><%= p.roomId ? p.roomId.roomNumber : '-' %></a></td>
          <td data-label="Member"><a href="/members/<%= p.memberId ? p.memberId._id : '' %>"><%= p.memberId ? p.memberId.name : '-' %></a></td>
          <td data-label="Rent period">
            <% if (p.rentPeriodId) { %>
              <a href="/rent-periods/<%= p.rentPeriodId._id %>"><%= formatRange(p.rentPeriodId.startDate, p.rentPeriodId.endDate) %></a>
            <% } else { %>-<% } %>
          </td>
          <td class="num paid" data-label="Amount"><%= currency(p.amount) %></td>
          <td data-label="Method"><%= p.paymentMethod %></td>
          <td class="muted" data-label="Reference"><%= p.reference || '-' %></td>
          <td data-label="Period status">
            <% if (p.rentPeriodId) { %>
              <span class="pill pill-<%= p.rentPeriodId.status.toLowerCase() %>"><%= p.rentPeriodId.status %></span>
            <% } else { %>-<% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (pages > 1) { %>
    <nav class="pagination">
      <% for (let i = 1; i <= pages; i += 1) { %>
        <a class="<%= i === page ? 'active' : '' %>" href="/payments?page=<%= i %>&roomId=<%= encodeURIComponent(filters.roomId) %>&memberId=<%= encodeURIComponent(filters.memberId) %>&paymentMethod=<%= encodeURIComponent(filters.paymentMethod) %>&from=<%= encodeURIComponent(filters.from) %>&to=<%= encodeURIComponent(filters.to) %>"><%= i %></a>
      <% } %>
    </nav>
  <% } %>
</section>
